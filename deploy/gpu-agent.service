# GPU agent for machines running a third-party engine (serves GPU/CPU/RAM to the dashboard, port 9835).
#   mkdir -p ~/.config/systemd/user && cp gpu-agent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now gpu-agent.service
# Adjust the path if the repo lives elsewhere. Only gpu-agent.py is needed (a single file).
[Unit]
Description=GPU agent for cluster-dashboard
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I %h/tools/cluster-dashboard/bin/gpu-agent.py --port 9835
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
