# <DASHBOARD_DIR> = folder where AIdashy is cloned. Install with (from that folder):
#   sed "s#<DASHBOARD_DIR>#$PWD#g" deploy/gpu-agent.service > ~/.config/systemd/user/gpu-agent.service
# GPU agent for machines running a third-party engine (serves GPU/CPU/RAM to the dashboard, port 9835).
#   (create ~/.config/systemd/user first if it does not exist)
#   systemctl --user daemon-reload && systemctl --user enable --now gpu-agent.service
# Only bin/gpu-agent.py is needed (a single file).
[Unit]
Description=GPU agent for cluster-dashboard
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I <DASHBOARD_DIR>/bin/gpu-agent.py --port 9835
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
