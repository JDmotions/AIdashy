# Lets the dashboard user switch exactly this unit without a password.
# Install with:  sudo visudo -f /etc/sudoers.d/miner-dashboard
# Adjust <user> and miner.service; check the systemctl path with `command -v systemctl`.
<user> ALL=(root) NOPASSWD: /usr/bin/systemctl start miner.service, /usr/bin/systemctl stop miner.service, /usr/bin/systemctl restart miner.service
