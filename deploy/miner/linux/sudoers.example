# Erlaubt dem Dashboard-Benutzer, genau diese Unit ohne Passwort zu schalten.
# Installieren mit:  sudo visudo -f /etc/sudoers.d/miner-dashboard
# <benutzer> und miner.service anpassen; Pfad von systemctl mit `command -v systemctl` pruefen.
<benutzer> ALL=(root) NOPASSWD: /usr/bin/systemctl start miner.service, /usr/bin/systemctl stop miner.service, /usr/bin/systemctl restart miner.service
